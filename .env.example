# ─── Application ──────────────────────────────────────────────
# URL publique du site (sans slash final). Sert aux redirections Stripe et aux e-mails.
APP_URL=http://localhost:3000

# Chemin du fichier SQLite (créé automatiquement).
DATABASE_PATH=./data/charpente.db

# Adresses e-mail ayant accès au tableau de bord /admin (séparées par des virgules).
ADMIN_EMAILS=

# Mettre à "true" uniquement si le site est derrière un proxy de confiance
# (Nginx, Caddy, Render, Railway…) qui renseigne X-Forwarded-For.
TRUST_PROXY=false

# ─── Stripe (paiement unique) ─────────────────────────────────
# Clés disponibles sur https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Secret du webhook (Dashboard > Développeurs > Webhooks, ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# En développement uniquement : sans clé Stripe, les achats sont simulés.
# Ignoré en production.
DEMO_CHECKOUT=true

# ─── E-mails transactionnels (SMTP) ───────────────────────────
# Sans configuration, les e-mails sont affichés dans la console (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Charpente <bonjour@charpente.fr>"
